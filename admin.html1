<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Game Admin</title>
<meta name="robots" content="noindex">
<style>
  :root{--bg:#0b0613;--card:#170d26;--line:rgba(255,255,255,.12);--text:#f3e9d7;--muted:#b9aacb;--gold:#e8c46a;--ok:#8ee6a5;--bad:#ff8a8a}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding:24px 16px}
  .card{max-width:560px;margin:0 auto 18px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px}
  h1{font-family:Georgia,serif;font-size:24px;margin:0 0 4px;letter-spacing:.05em}
  h2{font-size:16px;margin:0 0 10px;color:var(--gold)}
  p{color:var(--muted);line-height:1.5;margin:0 0 12px;font-size:14px}
  textarea{width:100%;min-height:180px;background:#0e0718;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:10px;font:14px/1.5 ui-monospace,Menlo,Consolas,monospace}
  button{font:inherit;font-weight:600;border:0;border-radius:10px;padding:11px 16px;cursor:pointer;background:#fff;color:#1f1f1f;margin-top:10px}
  .ghost{background:transparent;color:var(--muted);border:1px solid var(--line)}
  input[type=file]{color:var(--muted);margin:6px 0}
  .msg{font-size:14px;margin-top:10px;min-height:1.2em}
  .ok{color:var(--ok)}.bad{color:var(--bad)}
  [hidden]{display:none!important}
</style>
</head>
<body>
<div class="card">
  <h1>Light and Darkness · Admin</h1>
  <p id="who">Only the game’s owner can use this page.</p>
  <button id="bSignin">Sign in with Google</button>
  <button id="bOut" class="ghost" hidden>Sign out</button>
  <div class="msg" id="authMsg"></div>
</div>

<div id="panels" hidden>
  <div class="card">
    <h2>1 · Friends who can play</h2>
    <p>One email per line. Use the exact Google account email each friend signs in with. Save after changes.</p>
    <textarea id="emails" spellcheck="false" placeholder="friend1@gmail.com&#10;friend2@gmail.com"></textarea>
    <button id="bSave">Save friends list</button>
    <div class="msg" id="saveMsg"></div>
  </div>

  <div class="card">
    <h2>2 · Upload the game</h2>
    <p>Choose the game’s <b>index.html</b> (from light-and-darkness-paid.zip). Upload again whenever you update the game.</p>
    <input type="file" id="file" accept=".html,text/html">
    <br><button id="bUpload">Upload game</button>
    <div class="msg" id="upMsg"></div>
  </div>
</div>

<script src="config.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script>
(function(){
  const $ = id => document.getElementById(id);
  const say = (el, text, cls) => { $(el).textContent = text; $(el).className = 'msg ' + (cls || ''); };
  if (location.protocol === 'file:') {
    say('authMsg', 'This page was opened from a file on your computer. Open it from the website link instead (https://…github.io/light-and-darkness/admin.html).', 'bad'); $('bSignin').hidden = true; return;
  }
  if (!window.FIREBASE_CONFIG || String(FIREBASE_CONFIG.apiKey).indexOf('PASTE') === 0) {
    say('authMsg', 'Paste your Firebase config into config.js first.', 'bad'); $('bSignin').hidden = true; return;
  }
  firebase.initializeApp(FIREBASE_CONFIG);
  const auth = firebase.auth(), db = firebase.firestore();
  const provider = new firebase.auth.GoogleAuthProvider();
  provider.setCustomParameters({ prompt: 'select_account' });
  const CHUNK = 300000; // characters per piece (keeps each piece well under Firestore's 1 MB limit)

  $('bSignin').onclick = async () => {
    try { await auth.signInWithPopup(provider); }
    catch (e) { if (!e || e.code !== 'auth/popup-closed-by-user') say('authMsg', 'Sign-in failed: ' + (e.message || e), 'bad'); }
  };
  $('bOut').onclick = () => auth.signOut();

  auth.onAuthStateChanged(async user => {
    $('bSignin').hidden = !!user; $('bOut').hidden = !user; $('panels').hidden = true; say('authMsg', '');
    if (!user) { $('who').textContent = 'Only the game’s owner can use this page.'; return; }
    $('who').textContent = 'Signed in as ' + user.email;
    try {
      const d = await db.collection('config').doc('allow').get();
      $('emails').value = d.exists ? (d.data().emails || []).join('\n') : '';
      $('panels').hidden = false;
    } catch (e) {
      if (e.code === 'permission-denied') say('authMsg', 'This account is not the owner. Check the email in your Firestore rules.', 'bad');
      else say('authMsg', 'Error: ' + (e.message || e), 'bad');
    }
  });

  $('bSave').onclick = async () => {
    const list = [...new Set($('emails').value.split(/[\s,;]+/).map(s => s.trim().toLowerCase()).filter(s => s.includes('@')))];
    try {
      await db.collection('config').doc('allow').set({ emails: list, updated: firebase.firestore.FieldValue.serverTimestamp() });
      $('emails').value = list.join('\n');
      say('saveMsg', 'Saved. ' + list.length + ' friend' + (list.length === 1 ? '' : 's') + ' can play.', 'ok');
    } catch (e) { say('saveMsg', 'Could not save: ' + (e.message || e), 'bad'); }
  };

  $('bUpload').onclick = async () => {
    const f = $('file').files[0];
    if (!f) { say('upMsg', 'Choose the game’s index.html first.', 'bad'); return; }
    const text = await f.text();
    if (text.indexOf('Light and Darkness') < 0) { say('upMsg', 'That doesn’t look like the game file. Choose index.html from light-and-darkness-paid.zip.', 'bad'); return; }
    const n = Math.ceil(text.length / CHUNK);
    try {
      for (let i = 0; i < n; i++) {
        say('upMsg', 'Uploading… ' + Math.round(i / n * 100) + '%');
        await db.collection('game').doc('c' + i).set({ t: text.slice(i * CHUNK, (i + 1) * CHUNK) });
      }
      await db.collection('game').doc('meta').set({ n: n, size: text.length, updated: firebase.firestore.FieldValue.serverTimestamp() });
      say('upMsg', 'Uploaded! Friends on the list can now play the latest version.', 'ok');
    } catch (e) { say('upMsg', 'Upload failed: ' + (e.message || e), 'bad'); }
  };
})();
</script>
</body>
</html>
